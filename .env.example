# Copy to .env and replace every example value before running Docker Compose.
MONGO_INITDB_ROOT_USERNAME=hidden_gems
MONGO_INITDB_ROOT_PASSWORD=replace_with_hex_from_openssl_rand_hex_32
MONGODB_URI=mongodb://hidden_gems:replace_with_hex_from_openssl_rand_hex_32@mongo:27017/hidden-gems?authSource=admin
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:8080
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
